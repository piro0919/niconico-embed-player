{
  "name": "niconico-embed-player",
  "version": "0.1.2",
  "description": "Unofficial controller for the Niconico embed player (embed.nicovideo.jp), with a preloader for instant playback on iPhone and iPad",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "niconico",
    "nicovideo",
    "embed",
    "iframe",
    "player",
    "postmessage",
    "video"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/niconico-embed-player.git"
  },
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/niconico-embed-player/issues"
  },
  "homepage": "https://niconico-embed-player.kkweb.io",
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build:lib",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "dev": "next dev -p 3150",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "test:e2e:real": "playwright test --project=real"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@piro0919/biome-config": "github:piro0919/biome-config#v1.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.2",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
